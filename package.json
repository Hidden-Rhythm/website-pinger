{
  "name": "pulse",
  "version": "1.0.0",
  "description": "Pulse — Advanced Database-Free Website Monitoring Platform",
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"cyan,magenta\" \"python -m uvicorn api.index:app --host 127.0.0.1 --port 8000\" \"next dev -p 3000\"",
    "dev:web": "next dev -p 3000",
    "dev:api": "python -m uvicorn api.index:app --host 127.0.0.1 --port 8000 --reload",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "python -m pytest tests/ -v"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "5.9.3"
  }
}
